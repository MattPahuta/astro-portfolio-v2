---
import ContactButton from "./ContactButton.astro";

const contactList = [
  {
    label: "Email",
    href: "mailto:mhpahuta@gmail.com",
    handle: "mhpahuta@gmail.com",
    iconName: "mdi:email",
  },
  {
    label: "LinkedIn",
    href: "https://linkedin.com/in/mattpahuta",
    handle: "/in/MattPahuta",
    iconName: "mdi:linkedin",
  },
  {
    label: "GitHub",
    href: "https://github.com/MattPahuta",
    handle: "@MattPahuta",
    iconName: "mdi:github",
  },
];
---

<section id="contact" class="py-6">
  <!-- outer card -->
  <div class="space-y-8 px-4 sm:px-6 lg:px-8">
    <!-- inner flex card -->
    <div
      class="p-6 md:p-10 bg-ice-dagger shadow-sm rounded-3xl grid gap-6 sm:gap-12 sm:grid-cols-[minmax(0,1fr)_auto]">
      <!-- flex item -->
      <div class="space-y-2">
        <p class="text-sm uppercase text-zinc-700 tracking-tight">
          get in touch
        </p>
        <h2 class="text-2xl sm:text-3xl font-medium">
          Let's make the web work better.
        </h2>
        <p class="max-w-prose">
          I'm always happy to talk about accessibility, frontend
          engineering, open-source collaboration, or potential
          opportunities.
        </p>
      </div>
      <!-- flex item -->
      <!-- contact button wrapper -->
      <div class="">
        <ul class="flex flex-col gap-2">
          {
            contactList.map((item) => (
              <li class="">
                <ContactButton
                  label={item.label}
                  href={item.href}
                  handle={item.handle}
                  iconName={item.iconName}
                />
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>
