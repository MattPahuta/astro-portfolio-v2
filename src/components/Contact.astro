---
import ContactButton from "./ContactButton.astro";

const contactList = [
  {
    label: "Email",
    href: "mailto:mhpahuta@gmail.com",
    handle: "mhpahuta@gmail.com",
    iconName: "mdi:email",
  },
  {
    label: "LinkedIn",
    href: "https://linkedin.com/in/mattpahuta",
    handle: "/in/MattPahuta",
    iconName: "mdi:linkedin",
  },
  {
    label: "GitHub",
    href: "https://github.com/MattPahuta",
    handle: "@MattPahuta",
    iconName: "mdi:github",
  },
];
---

<section id="contact" class="py-6">
  <!-- outer card -->
  <div class="space-y-8 px-4 sm:px-6 lg:px-8">
    <!-- inner flex card -->
    <div
      class="p-6 sm:p-10 bg-ice-dagger shadow-sm rounded-3xl grid gap-4 sm:gap-5 lg:grid-cols-[2fr_1fr]">
      <!-- grid item -->
      <div class="">
        <p
          class="mb-2 text-sm uppercase text-zinc-700 tracking-tight">
          get in touch
        </p>
        <h2 class="mb-3 text-2xl sm:text-3xl md:text-4xl font-medium">
          Let's make the web work better.
        </h2>
        <p class="max-w-prose md:text-[1.0625rem] text-zinc-700">
          I'm always happy to talk about accessibility, frontend
          engineering, open-source collaboration, or potential
          opportunities.
        </p>
      </div>
      <!-- grid item -->
      <!-- contact button list -->
      <ul class="flex flex-wrap gap-3 lg:flex-col" role="list">
        {
          contactList.map((item) => (
            <li class="">
              <ContactButton
                label={item.label}
                href={item.href}
                handle={item.handle}
                iconName={item.iconName}
              />
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
