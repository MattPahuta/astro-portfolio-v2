---
import SectionDivider from "./SectionDivider.astro";
import SectionHeader from "./SectionHeader.astro";
import ProjectCard from "./ProjectCard.astro";
import Card from "./Card.astro";
import { getCollection } from "astro:content";
const projects = await getCollection("project");
---

<section id="projects" class="py-6">
  <div class="px-4 sm:px-6 lg:px-8">
    <SectionHeader
      eyebrow="selected work"
      heading="Featured Projects"
    />

    <div class="py-10 grid gap-6">
      {
        projects.map((project) => (
          <ProjectCard
            title={project.data.title}
            description={project.data.description}
            imagePath={project.data.imagePath}
            imageAltText={project.data.imageAltText}
            techStack={project.data.techStack}
            gitHubUrl={project.data.gitHubUrl}
            liveSiteUrl={project.data.liveSiteUrl}
          />
        ))
      }
    </div>
  </div>
</section>
