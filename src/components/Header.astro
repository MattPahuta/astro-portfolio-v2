---
import { Image } from "astro:assets";
import profileImage from "../assets/profile-primary.webp";
import SocialList from "./SocialList.astro";

const navMenuItems = [
  { label: "About", href: "#about" },
  { label: "Projects", href: "#projects" },
  { label: "Contact", href: "#contact" },
];
---

<header class="py-6 px-8 border-b border-stone-200">
  <nav class="flex flex-col sm:flex-row items-start sm:items-center justify-between">
    <!-- identity card -->
    <a
      href="/"
      class="group mb-6 sm:mb-0 rounded-sm flex items-center gap-3 transition-colors focus-visible:outline-2 focus-visible:outline-offset-4">
      <!-- img -->
      <Image
        src={profileImage}
        alt="Matt Pahuta"
        class="size-12 object-cover rounded-full"
      />
      <!-- id details -->
      <div class="flex flex-col">
        <span class="font-semibold group-hover:text-accent"
          >Matt Pahuta</span
        >
        <span class="text-sm text-zinc-600">Frontend Engineer</span>
      </div>
    </a>

    <ul class="flex gap-5 items-center">
      {
        navMenuItems.map((item) => (
          <li>
            <a
              href={item.href}
              class="text-zinc-600 uppercase rounded-sm hover:text-accent transition-colors focus-visible:outline-2 focus-visible:outline-offset-4">
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
    <div class="hidden sm:block">
      <SocialList />
    </div>
  </nav>
</header>
