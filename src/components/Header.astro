---
import { Image } from "astro:assets";
import profileImage from "../assets/profile-primary.webp";
import SocialList from "./SocialList.astro";

const navMenuItems = [
  { label: "About", href: "#about" },
  { label: "Projects", href: "#projects" },
  { label: "Contact", href: "#contact" },
];
---

<header class="py-6 px-8 border-b border-stone-200">
  <nav
    class="flex flex-col gap-6 sm:flex-row flex-wrap items-start sm:items-center justify-between"
    aria-label="Primary">
    <a
      href="/"
      class="card group rounded-sm flex items-center gap-3 transition-colors focus-visible:outline-2 focus-visible:outline-offset-2">
      <Image
        src={profileImage}
        alt="Matt Pahuta"
        class="size-12 object-cover rounded-full"
      />
      <div class="flex flex-col">
        <span
          class="font-jost text-[1.0625rem] font-semibold leading-[1.1] tracking-wide"
          >Matt Pahuta</span
        >
        <span class="text-sm text-muted">Frontend Engineer</span>
      </div>
    </a>
    <ul
      class="menu flex gap-2 items-center text-muted uppercase text-sm sm:text-base"
      role="list">
      {
        navMenuItems.map((item) => (
          <li>
            <a
              href={item.href}
              class="px-3 py-1.5 rounded-sm hover:bg-zinc-200 hover:text-zinc-900 transition-colors focus-visible:outline-2 focus-visible:outline-offset-2">
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
    <div class="socials hidden sm:block">
      <SocialList />
    </div>
  </nav>
</header>
