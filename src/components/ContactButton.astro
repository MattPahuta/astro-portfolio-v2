---
import { Icon } from "astro-icon/components";
const { label, handle, href, iconName } = Astro.props;
---

<a
  href=`${href}`
  target="_blank"
  rel="noreferrer noopener"
  class="group w-full py-2 px-4 inline-flex items-center gap-2 rounded-lg bg-transparent shadow-sm border border-zinc-500 focus-visible:outline-2 focus-visible:outline-offset-4 hover:shadow-md transition-transform duration-300 hover:-translate-y-0.5">
  <Icon
    name=`${iconName}`
    aria-hidden="true"
    focusable="false"
    class="size-6 text-zinc-700"
  />
  <!-- <span class="text-zinc-800 text-base font-medium transition-colors"
    >{label}</span
  > -->
  <div class="flex flex-col">
    <span
      class="text-zinc-800 text-base font-medium transition-colors"
      >{label}</span
    >
    <span class="text-sm text-zinc-600 transition-colors"
      >{handle}</span
    >
  </div>
</a>
