---
import { Icon } from "astro-icon/components";
const { label, handle, href, iconName } = Astro.props;
---

<a
  href=`${href}`
  target="_blank"
  rel="noreferrer noopener"
  class="group w-full py-2 px-4 inline-flex items-center gap-2 lg:gap-3.5 rounded-lg bg-transparent shadow-sm border border-zinc-500 focus-visible:outline-2 focus-visible:outline-offset-4 hover:shadow-md transition-transform duration-300 hover:-translate-y-0.5 motion-reduce:transition-none motion-reduce:hover:transform-none">
  <Icon
    name=`${iconName}`
    aria-hidden="true"
    focusable="false"
    class="size-6 lg:size-7 text-zinc-700"
  />
  <div class="flex flex-col text-zinc-800">
    <span class="font-medium text-[0.9375rem]"
      >{label}</span
    >
    <span
      class="hidden lg:block text-sm font-light"
      >{handle}</span
    >
  </div>
</a>
