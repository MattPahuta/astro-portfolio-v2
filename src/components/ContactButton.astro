---
import { Icon } from "astro-icon/components";
const { label, handle, href, iconName } = Astro.props;

/*
inline-flex min-h-12 items-center gap-2 justify-self-start rounded-full bg-sky-400 py-3 pr-4 pl-5 font-medium text-zinc-950 shadow-sm ring-1 ring-sky-400 transition-transform duration-300 hover:translate-y-[-2px]

// buttons: add translate-y and shadow for hover
*/

---

<a
  href=`${href}`
  target="_blank"
  rel="noreferrer noopener"
  class="group w-full py-2 px-3 inline-flex items-center gap-4 rounded-lg border border-zinc-600 bg-transparent focus-visible:outline-2 focus-visible:outline-offset-2 transition">
  <Icon
    name=`${iconName}`
    aria-hidden="true"
    focusable="false"
    class="size-7 text-zinc-700"
  />
  <div class="flex flex-col">
    <span
      class="text-zinc-800 text-base font-medium transition-colors"
      >{label}</span
    >
    <span
      class="text-sm text-zinc-600 transition-colors"
      >{handle}</span
    >
  </div>
</a>
