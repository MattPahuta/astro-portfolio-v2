---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

interface Props {
  title: string;
  description: string;
  imagePath: string;
  imageAltText: string;
  techStack: string[];
  gitHubUrl: string;
  liveSiteUrl: string;
}

const {
  title,
  description,
  imagePath,
  imageAltText,
  techStack,
  gitHubUrl,
  liveSiteUrl,
} = Astro.props;
const images = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/projects/*.{jpeg,jpg,png,gif}",
);

if (!images[imagePath])
  throw new Error(
    `"${imagePath}" does not exist in glob: "src/assets/projects/*.{jpeg,jpg,png,gif}"`,
  );
---

<article
  class="min-w-0 overflow-hidden rounded-2xl bg-white shadow-sm ring-1 ring-black/5">
  <div
    class="overflow-hidden bg-white">
    <div
      class="relative flex w-full items-center gap-3 border-b border-black/5 bg-zinc-50 py-3 pr-14.5 pl-14.5">
      <!-- chrome window buttons -->
      <div
        class="flex gap-1.5 absolute top-1/2 -translate-y-1/2 left-4">
        <span class="size-2.5 rounded-full bg-zinc-300"></span>
        <span class="size-2.5 rounded-full bg-zinc-300"></span>
        <span class="size-2.5 rounded-full bg-zinc-300"></span>
      </div>
      <div
        class="min-w-0 flex-1 truncate text-center font-mono text-xs text-zinc-400 sm:text-sm">
        <span>www.examplewebsite.app</span>
      </div>
    </div>
    <!-- outer image wrapper -->
    <div class="block w-full h-auto">
      <!-- inner image wrapper -->
      <div class="aspect-video overflow-hidden w-full">
        <Image
          src={images[imagePath]()}
          alt={imageAltText}
          class="object-cover"
        />
      </div>
    </div>
  </div>
  <!-- card content -->
  <div class="p-6 sm:p-9">
    <h2
      class="font-medium text-2xl tracking-tight text-balance text-zinc-950 sm:text-3xl">
      {title}
    </h2>
    <!-- tech tags -->
    <ul
      class="flex flex-wrap gap-y-1 gap-x-3.5 sm:gap-y-2 sm:gap-x-5 text-slate-500 text-sm sm:text-base"
      role="list">
      {
        techStack.map((tech) => (
          <li class="py-0.5 px-2 flex gap-1.5 items-center text-xs border border-gray-600 font-mono text-gray-400">
            {tech}
          </li>
        ))
      }
    </ul>
    <!-- project description -->
    <p class="mb-5 text-base text-pretty text-zinc-600 sm:text-lg">
      {description}
    </p>
  </div>
</article>
