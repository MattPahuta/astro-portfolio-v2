---
import { Image } from "astro:assets";
import profileImage from "../assets/profile-primary.webp";
import SectionDivider from "../components/SectionDivider.astro";
---

<section class="px-8 py-6 md:p-12">
  <!-- flex layout container -->
  <div
    class="lg:px-8 flex flex-col items-center lg:flex-row lg:gap-4">
    <!-- hero headline and about text -->
    <div class="">
      <p class="mb-2 text-lg sm:text-xl text-muted">Hi, I'm Matt!</p>
      <h1
        class="mb-4 max-w-[18ch] font-serif font-bold leading-[1.1] text-4xl sm:text-5xl">
        I build web experiences that don't just work — they make
        sense.
      </h1>
      <div
        class="space-y-3 max-w-prose text-muted leading-relaxed md:text-lg">
        <p>
          I'm a frontend engineer focused on building responsive
          interfaces with React, Astro, and Tailwind CSS, with
          accessibility and usability considered from the start.
        </p>
        <p>
          My background in technology, business analysis, and project
          management helps me bridge the gap between technical
          solutions, team collaboration, and user needs.
        </p>
      </div>
    </div>
    <!-- hero image -->
    <div class="hidden shrink-0 lg:block">
      <Image
        src={profileImage}
        alt="Matt Pahuta"
        class="size-60 rounded-full border-2 border-zinc-200/60 object-cover shadow-sm"
      />
    </div>
  </div>
</section>
