---
import { Image } from "astro:assets";
import profileImage from "../assets/profile-primary.webp";

const techs = [
  "React",
  "TypeScript",
  "Astro",
  "Accessibility",
  "Tailwind CSS",
];
---

<section id="about" class="p-8 sm:py-12 md:px-12 md:py-16">
  <div
    class="lg:px-8 flex flex-col items-center lg:flex-row lg:gap-4">
    <div class="">
      <p class="mb-2 text-lg sm:text-xl text-zinc-700">
        Hi, I'm Matt!
      </p>
      <h1
        class="mb-4 lg:mb-6 max-w-[18ch] font-bold leading-[1.1] text-4xl sm:text-5xl">
        I build web experiences that don't just work <span class=""
          >—</span
        > they make sense.
      </h1>
      <div
        class="space-y-3 max-w-prose text-zinc-700 leading-relaxed md:text-lg">
        <p>
          I'm a frontend engineer focused on building responsive
          interfaces with React, Astro, and Tailwind CSS, with
          accessibility and usability considered from the start.
        </p>
        <p>
          My background in technology, business analysis, and project
          management helps me bridge the gap between technical
          solutions, team collaboration, and user needs.
        </p>
      </div>
      <ul
        class="mt-6 flex flex-wrap justify-start gap-x-3 gap-y-4 font-jost text-zinc-800 text-xs sm:text-sm"
        aria-label="Tools and focus">
        {
          techs.map((tech) => (
            <li class="py-1.5 px-4 bg-ice-dagger rounded-full shadow-xs">
              {tech}
            </li>
          ))
        }
      </ul>
    </div>
    <div class="hidden shrink-0 lg:block">
      <Image
        src={profileImage}
        alt="Matt Pahuta"
        class="size-56 rounded-full border border-ice-dagger/80 object-cover shadow-md"
      />
    </div>
  </div>
</section>
