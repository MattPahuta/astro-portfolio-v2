---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

interface Props {
  title: string;
  description: string;
  imagePath: string;
  imageAltText: string;
  techStack: string[];
  gitHubUrl: string;
  liveSiteUrl: string;
}

const {
  title,
  description,
  imagePath,
  imageAltText,
  techStack,
  gitHubUrl,
  liveSiteUrl,
} = Astro.props;
const images = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/projects/*.{jpeg,jpg,png,gif}",
);

if (!images[imagePath])
  throw new Error(
    `"${imagePath}" does not exist in glob: "src/assets/projects/*.{jpeg,jpg,png,gif}"`,
  );
---

<article
  class="p-5 sm:p-6 bg-white shadow-sm rounded-3xl text-left grid md:grid-cols-[325px_auto] gap-5 md:gap-7">
  <Image
    src={images[imagePath]()}
    alt={imageAltText}
    class="object-cover aspect-4/3 object-top rounded-lg"
  />
  <div class="w-full flex flex-col grow">
    <h3 class="mb-3 text-2xl leading-tight">
      {title}
    </h3>
    <ul
      class="mb-5 flex flex-wrap items-center gap-x-2 gap-y-2"
      role="list">
      {
        techStack.map((tech) => (
          <li class="py-1 px-2.5 rounded-full text-xs font-mono bg-stone-100 text-zinc-600">
            {tech}
          </li>
        ))
      }
    </ul>
    <p
      class="mb-8 text-base sm:text-[1.0625rem] text-neutral-700 leading-relaxed font-light max-w-prose">
      {description}
    </p>
    <footer class="flex items-center gap-3 mt-auto text-sm">
      <a
        href={gitHubUrl}
        target="_blank"
        rel="noreferrer nopener"
        class="py-1.5 px-2.5 text-zinc-600 border border-stone-300 font-medium inline-flex items-center justify-center gap-2 rounded-lg hover:border-zinc-200 hover:text-zinc-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-zinc-700 hover:shadow-sm transition-transform duration-300 hover:-translate-y-0.5 motion-reduce:transition-none motion-reduce:hover:transform-none">
        Source Code
      </a>
      <a
        href={liveSiteUrl}
        target="_blank"
        rel="noreferrer nopener"
        class="py-1.5 px-2.5 text-zinc-600 border border-stone-300 font-medium inline-flex items-center justify-center gap-2 rounded-lg hover:border-zinc-200 hover:text-zinc-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-zinc-700 hover:shadow-sm transition-transform duration-300 hover:-translate-y-0.5 motion-reduce:transition-none motion-reduce:hover:transform-none">
        Live Demo
      </a>
    </footer>
  </div>
</article>
