---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

interface Props {
  title: string;
  description: string;
  imagePath: string;
  imageAltText: string;
  techStack: string[];
  gitHubUrl: string;
  liveSiteUrl: string;
}

const {
  title,
  description,
  imagePath,
  imageAltText,
  techStack,
  gitHubUrl,
  liveSiteUrl,
} = Astro.props;
const images = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/projects/*.{jpeg,jpg,png,gif}",
);

if (!images[imagePath])
  throw new Error(
    `"${imagePath}" does not exist in glob: "src/assets/projects/*.{jpeg,jpg,png,gif}"`,
  );
---

<article
  class="group p-4 sm:p-6 bg-white shadow-sm rounded-2xl text-left grid md:grid-cols-[325px_auto] gap-5 md:gap-7">
  <!-- image wrapper -->
  <!-- thumbnail image -->
  <Image
    src={images[imagePath]()}
    alt={imageAltText}
    class="object-cover aspect-4/3 object-top rounded-xl"
  />

  <!-- card content -->
  <div class="w-full flex flex-col grow">
    <h3 class="mb-3 text-2xl leading-tight">
      {title}
    </h3>
    <ul
      class="mb-5 flex flex-wrap items-center gap-x-2 gap-y-2"
      role="list">
      {
        techStack.map((tech) => (
          <li class="py-1 px-2.5 rounded-full text-xs font-mono bg-stone-100 text-zinc-600">
            {tech}
          </li>
        ))
      }
    </ul>
    <p
      class="mb-8 text-base sm:text-[1.0625rem] text-neutral-700 leading-relaxed font-light max-w-prose">
      {description}
    </p>
    <footer class="flex items-center gap-1 mt-auto font-ubuntu">
      <a
        href={gitHubUrl}
        target="_blank"
        rel="noreferrer nopener"
        class="py-2 px-4 text-zinc-600 font-med inline-flex items-center justify-center gap-2 rounded-lg hover:bg-zinc-200 hover:text-zinc-900 transition-colors focus-visible:outline-2 focus-visible:outline-zinc-700">
        Source Code
      </a>
      <a
        href={liveSiteUrl}
        target="_blank"
        rel="noreferrer nopener"
        class="py-2 px-4 text-zinc-600 font-med inline-flex items-center justify-center gap-2 rounded-lg hover:bg-zinc-200 hover:text-zinc-900 transition-colors focus-visible:outline-2 focus-visible:outline-zinc-700">
        Live Demo
      </a>
    </footer>
  </div>
</article>
