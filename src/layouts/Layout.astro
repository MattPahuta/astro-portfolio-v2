---
import { Font } from "astro:assets";
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <Font cssVariable="--font-inter" />
    <Font cssVariable="--font-jost" />
    <title>Matt Pahuta</title>
  </head>
  <body
    class="min-h-screen antialiased lg:px-4 bg-stone-200 text-zinc-900 font-inter">
    <div
      class="mx-auto max-w-full min-h-screen flex flex-col bg-zinc-50 lg:my-8 lg:min-h-0 lg:max-w-5xl lg:rounded-2xl lg:shadow-sm">
      <slot />
    </div>
  </body>
</html>

<style is:global>
  html {
    scroll-behavior: smooth;
  }
  h1,
  h2,
  h3 {
    font-family: var(--font-jost);
  }
</style>
