---
import { Font } from "astro:assets";
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link
      rel="icon"
      type="image/png"
      sizes="96x96"
      href="/favicon-96x96.png"
    />
    <link
      rel="icon"
      href="/favicon.svg"
      type="image/svg+xml"
      sizes="any"
    />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="description"
      content="Web developer skilled in React and modern frontend technologies, with a focus on web accessibility and inclusive design."
    />
    <meta
      property="og:image"
      content="https://mattpahuta.dev/avatar-sm.jpg"
    />
    <meta property="og:url" content="https://mattpahuta.dev/" />
    <Font cssVariable="--font-inter" />
    <Font cssVariable="--font-jost" />
    <title>Matt Pahuta | Web Developer</title>
  </head>
  <body
    class="min-h-screen antialiased lg:px-4 bg-stone-200 text-zinc-900 font-inter">
    <div
      class="mx-auto max-w-full bg-zinc-50 lg:my-8 lg:min-h-0 lg:max-w-5xl lg:rounded-2xl lg:shadow-sm">
      <slot />
    </div>
  </body>
</html>

<style is:global>
  html {
    scroll-behavior: smooth;
  }
  h1,
  h2,
  h3 {
    font-family: var(--font-jost), system-ui, sans-serif;
  }
</style>
